# ==============================================================================
# CIVICCLEAN ENVIRONMENTAL ENFORCEMENT PLATFORM
# Environment Variables Configuration
# ==============================================================================

# --- Full Connection URLs (Frontend <-> Backend) ---
# Full origin URL of the Frontend client (whitelisted for CORS in FastAPI)
FRONTEND_URL=http://localhost:5173

# Full origin URL of the Backend API server (targeted by Vite reverse proxy)
BACKEND_URL=http://localhost:8000

# Comma-separated full origin URLs allowed by FastAPI for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend client API base path (used by React app)
# Use '/api' for proxy mode, or 'http://localhost:8000/api' for direct cross-origin access
VITE_API_URL=/api

# Vite dev proxy target (points to full Backend URL)
VITE_BACKEND_URL=http://localhost:8000

# --- Storage & Data Directories ---
DATABASE_URL=sqlite:///./data/incidents.db
EVIDENCE_DIR=./evidence
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./outputs

# --- AI Vision Model ---
MODEL_PATH=./models/baraa-best.pt

# --- Upload Limits (in bytes, default: 500 MB) ---
MAX_UPLOAD_BYTES=524288000

# --- Backward-Compatibility Aliases ---
FRONTEND_ORIGIN=http://localhost:5173
